{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip.schema.json",
  "title": "Itinerary (the real one is entered in the app and stays on the phone; only trip.example.json is committed)",
  "type": "object",
  "required": ["timeZone", "stops", "events"],
  "additionalProperties": false,
  "properties": {
    "timeZone": { "type": "string", "minLength": 1 },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["city", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "city": { "type": "string", "pattern": "^[a-z]+$" },
          "from": { "$ref": "#/$defs/date" },
          "to": { "$ref": "#/$defs/date" },
          "hotel": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "$ref": "#/$defs/text" },
              "address": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "date": { "$ref": "#/$defs/date" }
        }
      }
    },
    "diet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allergens": {
          "description": "The 14 allergens of Regulation (EU) No 1169/2011, Annex II, in annex order.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "gluten", "crustaceans", "eggs", "fish", "peanuts", "soybeans", "milk",
              "nuts", "celery", "mustard", "sesame", "sulphites", "lupin", "molluscs"
            ]
          }
        },
        "note": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "text": { "type": "string", "minLength": 1 }
  }
}
