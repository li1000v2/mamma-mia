{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trip.schema.json",
  "title": "Itinerary (the real one stays on the phone; only trip.example.json is committed)",
  "type": "object",
  "required": ["timeZone", "stops", "events"],
  "additionalProperties": false,
  "properties": {
    "timeZone": { "type": "string", "minLength": 1 },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["city", "from", "to"],
        "additionalProperties": false,
        "properties": {
          "city": { "type": "string", "pattern": "^[a-z]+$" },
          "from": { "$ref": "#/$defs/date" },
          "to": { "$ref": "#/$defs/date" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "date": { "$ref": "#/$defs/date" }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
