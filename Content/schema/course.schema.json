{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course.schema.json",
  "title": "Course map: frames, scenes, lessons and challenges",
  "type": "object",
  "required": ["version", "frames", "scenes", "units"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "text": { "type": "string", "minLength": 1 },
    "frame": {
      "type": "object",
      "required": ["id", "pattern", "use", "example"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "pattern": { "$ref": "#/$defs/text" },
        "use": { "$ref": "#/$defs/text" },
        "example": { "$ref": "#/$defs/text" }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "zh", "neededAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "zh": { "$ref": "#/$defs/text" },
        "neededAt": {
          "description": "When on the trip this scene is first needed; resolved against the imported trip.",
          "type": "string",
          "pattern": "^(first|last|city:[a-z]+|event:[a-z0-9_-]+)$"
        }
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "kind", "week", "title", "focus", "frames", "scene", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[LC][0-9]{2}$" },
        "kind": { "enum": ["lesson", "challenge"] },
        "week": { "type": "integer", "minimum": 1, "maximum": 5 },
        "title": { "$ref": "#/$defs/text" },
        "focus": { "$ref": "#/$defs/text" },
        "frames": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "scene": { "$ref": "#/$defs/id" },
        "summary": { "$ref": "#/$defs/text" }
      }
    }
  }
}
