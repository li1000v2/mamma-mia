{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "course.schema.json",
  "title": "Course map: frames, scenes, lessons and challenges, and the cities and events scenes are needed at",
  "type": "object",
  "required": ["version", "frames", "scenes", "cities", "events", "units"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "frames": { "type": "array", "items": { "$ref": "#/$defs/frame" } },
    "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
    "cities": { "type": "array", "items": { "$ref": "#/$defs/city" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "units": { "type": "array", "items": { "$ref": "#/$defs/unit" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "text": { "type": "string", "minLength": 1 },
    "frame": {
      "type": "object",
      "required": ["id", "pattern", "use", "example"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "pattern": { "$ref": "#/$defs/text" },
        "use": { "$ref": "#/$defs/text" },
        "example": { "$ref": "#/$defs/text" }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "zh", "neededAt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "zh": { "$ref": "#/$defs/text" },
        "neededAt": {
          "description": "When on the trip this scene is first needed; resolved against the imported trip.",
          "type": "string",
          "pattern": "^(first|last|city:[a-z]+|event:[a-z0-9_-]+)$"
        }
      }
    },
    "city": {
      "description": "A city the trip form offers; scenes refer to it as city:<id>.",
      "type": "object",
      "required": ["id", "zh", "it"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+$" },
        "zh": { "$ref": "#/$defs/text" },
        "it": { "$ref": "#/$defs/text" }
      }
    },
    "event": {
      "description": "A day with the same date every year; scenes refer to it as event:<id>, and a trip covering the date gets it automatically.",
      "type": "object",
      "required": ["id", "zh", "it", "month", "day"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "zh": { "$ref": "#/$defs/text" },
        "it": { "$ref": "#/$defs/text" },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "day": { "type": "integer", "minimum": 1, "maximum": 31 }
      }
    },
    "unit": {
      "type": "object",
      "required": ["id", "kind", "week", "title", "focus", "frames", "scene", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[LC][0-9]{2}$" },
        "kind": { "enum": ["lesson", "challenge"] },
        "week": { "type": "integer", "minimum": 1, "maximum": 5 },
        "title": { "$ref": "#/$defs/text" },
        "focus": { "$ref": "#/$defs/text" },
        "frames": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "scene": { "$ref": "#/$defs/id" },
        "summary": { "$ref": "#/$defs/text" }
      }
    }
  }
}
