{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue.schema.json",
  "title": "Offline scripted conversation for one challenge",
  "type": "object",
  "required": ["unit", "title", "goal", "speaker", "status", "nodes"],
  "additionalProperties": false,
  "properties": {
    "unit": { "type": "string", "pattern": "^C[0-9]{2}$" },
    "title": { "$ref": "#/$defs/text" },
    "goal": { "$ref": "#/$defs/text" },
    "speaker": { "$ref": "#/$defs/text" },
    "status": { "enum": ["draft", "checked", "native", "audio_ok"] },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "followUps": {
      "type": "object",
      "required": ["after", "min", "max", "pool"],
      "additionalProperties": false,
      "properties": {
        "after": { "$ref": "#/$defs/id" },
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 },
        "pool": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "text": { "type": "string", "minLength": 1 },
    "line": {
      "type": "object",
      "required": ["it", "zh"],
      "additionalProperties": false,
      "properties": {
        "it": { "$ref": "#/$defs/text" },
        "zh": { "$ref": "#/$defs/text" },
        "answer": { "$ref": "#/$defs/text" },
        "distractors": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "choice": {
      "type": "object",
      "required": ["it", "correct"],
      "additionalProperties": false,
      "properties": {
        "it": { "$ref": "#/$defs/text" },
        "correct": { "type": "boolean" },
        "feedback": { "$ref": "#/$defs/text" }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "npc"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "npc": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/line" } },
        "question": { "$ref": "#/$defs/text" },
        "reply": {
          "type": "object",
          "required": ["intent", "choices"],
          "additionalProperties": false,
          "properties": {
            "intent": { "$ref": "#/$defs/text" },
            "frame": { "$ref": "#/$defs/id" },
            "choices": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/choice" } }
          }
        }
      }
    }
  }
}
