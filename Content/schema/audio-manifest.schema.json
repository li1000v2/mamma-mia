{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "audio-manifest.schema.json",
  "title": "Audio/manifest.json: entry key \"<voice>|<speed>|<text>\" → file name",
  "type": "object",
  "required": ["version", "voices", "entries"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "voices": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+@[0-9]+$" }
    },
    "entries": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+@[0-9]+\\|[ns]\\|.+$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{16}\\.m4a$" }
    }
  }
}
